# ───── Public (safe to expose to the browser) ─────
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ───── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ─────
# Quran Foundation Content API (OAuth2 client credentials). When both are set,
# the app uses the authenticated API; otherwise it falls back to the public
# Quran.com v4 API. Request credentials at https://api-docs.quran.foundation
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# QF_TOKEN_URL=https://oauth2.quran.foundation/oauth2/token
# QF_API_BASE=https://apis.quran.foundation/content/api/v4
# QURAN_PUBLIC_API_BASE=https://api.quran.com/api/v4
# QURAN_TIMEOUT_MS=10000

# Official Haramain Imam/Muezzin schedule adapter (see README → "Haramain schedule").
# Leave empty until an official source is integrated: the UI then says the
# schedule cannot be confirmed — it never guesses.
HARAMAIN_SCHEDULE_URL=
HARAMAIN_SCHEDULE_API_KEY=
HARAMAIN_SCHEDULE_SOURCE_NAME=

# Provider for Imam/Muezzin names: haramainimams (default) | custom | none
HARAMAIN_SCHEDULE_PROVIDER=haramainimams
# HARAMAIN_IMAMS_BASE=https://haramainimams.com

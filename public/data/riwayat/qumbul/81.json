{"s":81,"name":"التَّكوير","nameEn":"At-Takwīr","ayahs":[[1,"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ١",586,30],[2,"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ٢",586,30],[3,"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ٣",586,30],[4,"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ٤",586,30],[5,"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ٥",586,30],[6,"وَإِذَا ٱلۡبِحَارُ سُجِرَتۡ ٦",586,30],[7,"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ٧",586,30],[8,"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ٨",586,30],[9,"بِأَيِّ ذَنۢبٖ قُتِلَتۡ ٩",586,30],[10,"وَإِذَا ٱلصُّحُفُ نُشِّرَتۡ ١٠",586,30],[11,"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ١١",586,30],[12,"وَإِذَا ٱلۡجَحِيمُ سُعِرَتۡ ١٢",586,30],[13,"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ١٣",586,30],[14,"عَلِمَتۡ نَفۡسٞ مَّا أَحۡضَرَتۡ ١٤",586,30],[15,"فَلَا أُقۡسِمُ بِٱلۡخُنَّسِ ١٥",586,30],[16,"ٱلۡجَوَارِ ٱلۡكُنَّسِ ١٦",586,30],[17,"وَٱلَّيۡلِ إِذَا عَسۡعَسَ ١٧",586,30],[18,"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ١٨",586,30],[19,"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ١٩",586,30],[20,"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ ٢٠",586,30],[21,"مُّطَاعٖ ثَمَّ أَمِينٖ ٢١",586,30],[22,"وَمَا صَاحِبُكُمُۥ بِمَجۡنُونٖ ٢٢",586,30],[23,"وَلَقَدۡ رَءَاهُۥ بِٱلۡأُفُقِ ٱلۡمُبِينِ ٢٣",586,30],[24,"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضظَنِينٖ ٢٤",586,30],[25,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ٢٥",586,30],[26,"فَأَيۡنَ تَذۡهَبُونَ ٢٦",586,30],[27,"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٢٧",586,30],[28,"لِمَن شَآءَ مِنكُمُۥ أَن يَسۡتَقِيمَ ٢٨",586,30],[29,"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ٢٩",586,30]]}
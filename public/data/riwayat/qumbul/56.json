{"s":56,"name":"الوَاقِعة","nameEn":"Al-Wāqi‘ah","ayahs":[[1,"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ ١",534,27],[2,"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ٢",534,27],[3,"خَافِضَةٞ رَّافِعَةٌ ٣",534,27],[4,"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا ٤",534,27],[5,"وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا ٥",534,27],[6,"فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا ٦",534,27],[7,"وَكُنتُمُۥ أَزۡوَٰجٗا ثَلَٰثَةٗ ٧",534,27],[8,"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ٨",534,27],[9,"مَا أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ٩",534,27],[10,"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ١٠",534,27],[11,"مَا أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ١١",534,27],[12,"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ ١٢",534,27],[13,"أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ ١٣",534,27],[14,"فِي جَنَّٰتِ ٱلنَّعِيمِ ١٤",534,27],[15,"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ١٥",534,27],[16,"وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ ١٦",534,27],[17,"عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ ١٧",534,27],[18,"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ١٨",534,27],[19,"يَطُوفُ عَلَيۡهِمُۥ وِلۡدَٰنٞ مُّخَلَّدُونَ ١٩",535,27],[20,"بِأَكۡوَابٖ وَأَبَارِيقَ ٢٠",535,27],[21,"وَكَأۡسٖ مِّن مَّعِينٖ ٢١",535,27],[22,"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ ٢٢",535,27],[23,"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٣",535,27],[24,"وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ ٢٤",535,27],[25,"وَحُورٌ عِينٞ كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ ٢٥",535,27],[26,"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ ٢٦",535,27],[27,"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا ٢٧",535,27],[28,"وَأَصۡحَٰبُ ٱلۡيَمِينِ ٢٨",535,27],[29,"مَا أَصۡحَٰبُ ٱلۡيَمِينِ ٢٩",535,27],[30,"فِي سِدۡرٖ مَّخۡضُودٖ ٣٠",535,27],[31,"وَطَلۡحٖ مَّنضُودٖ ٣١",535,27],[32,"وَظِلّٖ مَّمۡدُودٖ ٣٢",535,27],[33,"وَمَآءٖ مَّسۡكُوبٖ ٣٣",535,27],[34,"وَفَٰكِهَةٖ كَثِيرَةٖ ٣٤",535,27],[35,"لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ ٣٥",535,27],[36,"وَفُرُشٖ مَّرۡفُوعَةٍ ٣٦",535,27],[37,"إِنَّا أَنشَأۡنَٰهُنَّ إِنشَآءٗ ٣٧",535,27],[38,"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا ٣٨",535,27],[39,"عُرُبًا أَتۡرَابٗا ٣٩",535,27],[40,"لِّأَصۡحَٰبِ ٱلۡيَمِينِ ٤٠",535,27],[41,"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ٤١",535,27],[42,"وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ ٤٢",535,27],[43,"وَأَصۡحَٰبُ ٱلشِّمَالِ ٤٣",535,27],[44,"مَا أَصۡحَٰبُ ٱلشِّمَالِ ٤٤",535,27],[45,"فِي سَمُومٖ وَحَمِيمٖ وَظِلّٖ مِّن يَحۡمُومٖ ٤٥",535,27],[46,"لَّا بَارِدٖ وَلَا كَرِيمٍ ٤٦",535,27],[47,"إِنَّهُمُۥ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ ٤٧",535,27],[48,"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ ٤٨",535,27],[49,"وَكَانُواْ يَقُولُونَ ٤٩",535,27],[50,"أَى۪ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَ۟نَّا لَمَبۡعُوثُونَ ٥٠",535,27],[51,"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ٥١",535,27],[52,"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ ٥٢",535,27],[53,"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ ٥٣",535,27],[54,"ثُمَّ إِنَّكُمُۥ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ٥٤",536,27],[55,"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٥",536,27],[56,"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٥٦",536,27],[57,"فَشَٰرِبُونَ عَلَيۡهِۦ مِنَ ٱلۡحَمِيمِ ٥٧",536,27],[58,"فَشَٰرِبُونَ شَرۡبَ ٱلۡهِيمِ ٥٨",536,27],[59,"هَٰذَا نُزُلُهُمُۥ يَوۡمَ ٱلدِّينِ ٥٩",536,27],[60,"نَحۡنُ خَلَقۡنَٰكُمُۥ فَلَوۡلَا تُصَدِّقُونَ ٦٠",536,27],[61,"أَفَرَءَيۡتُمُۥ مَا تُمۡنُونَ ٦١",536,27],[62,"ءَا۬نتُمُۥ تَخۡلُقُونَهُۥ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ٦٢",536,27],[63,"نَحۡنُ قَدَرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٦٣",536,27],[64,"عَلَىٰ أَن نُّبَدِّلَ أَمۡثَٰلَكُمُۥ وَنُنشِئَكُمُۥ فِي مَا لَا تَعۡلَمُونَ ٦٤",536,27],[65,"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشَآءَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَّكَّرُونَ ٦٥",536,27],[66,"أَفَرَءَيۡتُمُۥ مَا تَحۡرُثُونَ ٦٦",536,27],[67,"ءَا۬نتُمُۥ تَزۡرَعُونَهُۥ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ٦٧",536,27],[68,"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُۥ حُطَٰمٗا فَظَلۡتُمُۥ تَفَكَّهُونَ ٦٨",536,27],[69,"إِنَّا لَمُغۡرَمُونَ ٦٩",536,27],[70,"بَلۡ نَحۡنُ مَحۡرُومُونَ ٧٠",536,27],[71,"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ٧١",536,27],[72,"ءَا۬نتُمُۥ أَنزَلۡتُمُوهُۥ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ٧٢",536,27],[73,"لَوۡ نَشَآءُ جَعَلۡنَٰهُۥ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ٧٣",536,27],[74,"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ٧٤",536,27],[75,"ءَا۬نتُمُۥ أَنشَأۡتُمُۥ شَجَرَتَهَا أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ٧٥",536,27],[76,"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ٧٦",536,27],[77,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٧٧",536,27],[78,"۞ فَلَا أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ٧٨",536,27],[79,"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ٧٩",536,27],[80,"إِنَّهُۥ لَقُرَانٞ كَرِيمٞ ٨٠",537,27],[81,"فِي كِتَٰبٖ مَّكۡنُونٖ ٨١",537,27],[82,"لَّا يَمَسُّهُۥ إِلَّا ٱلۡمُطَهَّرُونَ ٨٢",537,27],[83,"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٨٣",537,27],[84,"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُمُۥ مُدۡهِنُونَ ٨٤",537,27],[85,"وَتَجۡعَلُونَ رِزۡقَكُمُۥ أَنَّكُمُۥ تُكَذِّبُونَ ٨٥",537,27],[86,"فَلَوۡلَا إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ٨٦",537,27],[87,"وَأَنتُمُۥ حِينَئِذٖ تَنظُرُونَ ٨٧",537,27],[88,"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِۦ مِنكُمُۥ وَلَٰكِن لَّا تُبۡصِرُونَ ٨٨",537,27],[89,"فَلَوۡلَا إِن كُنتُمُۥ غَيۡرَ مَدِينِينَ ٨٩",537,27],[90,"تَرۡجِعُونَهَا إِن كُنتُمُۥ صَٰدِقِينَ ٩٠",537,27],[91,"فَأَمَّا إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ٩١",537,27],[92,"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ٩٢",537,27],[93,"وَأَمَّا إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩٣",537,27],[94,"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩٤",537,27],[95,"وَأَمَّا إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ٩٥",537,27],[96,"فَنُزُلٞ مِّنۡ حَمِيمٖ ٩٦",537,27],[97,"وَتَصۡلِيَةُ جَحِيمٍ ٩٧",537,27],[98,"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ٩٨",537,27],[99,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٩٩",537,27]]}
{"s":80,"name":"عَبَسَ","nameEn":"‘Abasa","ayahs":[[1,"عَبَسَ وَتَوَلَّىٰ ١",585,30],[2,"أَن جَآءَهُ ٱلۡأَعۡمَىٰ ٢",585,30],[3,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰ ٣",585,30],[4,"أَوۡ يَذَّكَّرُ فَتَنفَعُهُ ٱلذِّكۡرَىٰ ٤",585,30],[5,"أَمَّا مَنِ ٱسۡتَغۡنَىٰ ٥",585,30],[6,"فَأَنتَ لَهُۥ تَصَّدَّىٰ ٦",585,30],[7,"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ٧",585,30],[8,"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ٨",585,30],[9,"وَهُوَ يَخۡشَىٰ ٩",585,30],[10,"فَأَنتَ عَنۡهُۥ تَلَهَّىٰ ١٠",585,30],[11,"كَلَّا إِنَّهَا تَذۡكِرَةٞ ١١",585,30],[12,"فَمَن شَآءَ ذَكَرَهُۥ ١٢",585,30],[13,"فِي صُحُفٖ مُّكَرَّمَةٖ ١٣",585,30],[14,"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤",585,30],[15,"بِأَيۡدِي سَفَرَةٖ ١٥",585,30],[16,"كِرَامِۭ بَرَرَةٖ ١٦",585,30],[17,"قُتِلَ ٱلۡإِنسَٰنُ مَا أَكۡفَرَهُۥ ١٧",585,30],[18,"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨",585,30],[19,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩",585,30],[20,"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠",585,30],[21,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١",585,30],[22,"ثُمَّ إِذَا شَآءَ ا۬نشَرَهُۥ ٢٢",585,30],[23,"كَلَّا لَمَّا يَقۡضِ مَا أَمَرَهُۥ ٢٣",585,30],[24,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦ ٢٤",585,30],[25,"إِنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥",585,30],[26,"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ٢٦",585,30],[27,"فَأَنۢبَتۡنَا فِيهَا حَبّٗا ٢٧",585,30],[28,"وَعِنَبٗا وَقَضۡبٗا ٢٨",585,30],[29,"وَزَيۡتُونٗا وَنَخۡلٗا ٢٩",585,30],[30,"وَحَدَآئِقَ غُلۡبٗا ٣٠",585,30],[31,"وَفَٰكِهَةٗ وَأَبّٗا ٣١",585,30],[32,"مَّتَٰعٗا لَّكُمُۥ وَلِأَنۡعَٰمِكُمُۥ ٣٢",585,30],[33,"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ٣٣",585,30],[34,"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِۦ ٣٤",585,30],[35,"وَأُمِّهِۦ وَأَبِيهِۦ ٣٥",585,30],[36,"وَصَٰحِبَتِهِۦ وَبَنِيهِۦ ٣٦",585,30],[37,"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمُۥ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِۦ ٣٧",585,30],[38,"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ٣٨",585,30],[39,"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ٣٩",585,30],[40,"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ٤٠",585,30],[41,"تَرۡهَقُهَا قَتَرَةٌ ٤١",586,30],[42,"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ٤٢",586,30]]}
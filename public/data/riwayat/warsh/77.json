{"s":77,"name":"المُرسَلات","nameEn":"Al-Mursalāt","ayahs":[[1,"وَالْمُرْسَلَٰتِ عُرْفاٗ ١",580,29],[2,"فَالْعَٰصِفَٰتِ عَصْفاٗ ٢",580,29],[3,"وَالنَّٰشِرَٰتِ نَشْراٗ ٣",580,29],[4,"فَالْفَٰرِقَٰتِ فَرْقاٗ ٤",580,29],[5,"فَالْمُلْقِيَٰتِ ذِكْراً ٥",580,29],[6,"عُذْراً اَوْ نُذُراً ٦",580,29],[7,"اِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ ٧",580,29],[8,"فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ ٨",580,29],[9,"وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ ٩",580,29],[10,"وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ ١٠",580,29],[11,"وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ ١١",580,29],[12,"لِأَيِّ يَوْمٍ ا۟جِّلَتْ ١٢",580,29],[13,"لِيَوْمِ اِ۬لْفَصْلِۖ ١٣",580,29],[14,"وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ ١٤",580,29],[15,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ١٥",580,29],[16,"۞ أَلَمْ نُهْلِكِ اِ۬لَاوَّلِينَۖ ١٦",580,29],[17,"ثُمَّ نُتْبِعُهُمُ اُ۬لَاخِرِينَۖ ١٧",580,29],[18,"كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ ١٨",580,29],[19,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ١٩",580,29],[20,"أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ ٢٠",581,29],[21,"فَجَعَلْنَٰهُ فِے قَر۪ارٖ مَّكِينٍ ٢١",581,29],[22,"اِلَىٰ قَدَرٖ مَّعْلُومٖ ٢٢",581,29],[23,"فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ ٢٣",581,29],[24,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٢٤",581,29],[25,"أَلَمْ نَجْعَلِ اِ۬لَارْضَ كِفَاتاً ٢٥",581,29],[26,"اَحْيَآءٗ وَأَمْوَٰتاٗ ٢٦",581,29],[27,"وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ ٢٧",581,29],[28,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٢٨",581,29],[29,"اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ٢٩",581,29],[30,"اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ ٣٠",581,29],[31,"لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ ٣١",581,29],[32,"إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ ٣٢",581,29],[33,"كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ ٣٣",581,29],[34,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٣٤",581,29],[35,"هَٰذَا يَوْمُ لَا يَنطِقُونَ ٣٥",581,29],[36,"وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَۖ ٣٦",581,29],[37,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٣٧",581,29],[38,"هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ ٣٨",581,29],[39,"فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ ٣٩",581,29],[40,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٠",581,29],[41,"إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ ٤١",581,29],[42,"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ ٤٢",581,29],[43,"كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ ٤٣",581,29],[44,"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ٤٤",581,29],[45,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٥",581,29],[46,"كُلُواْ وَتَمَتَّعُواْ قَلِيلاً اِنَّكُم مُّجْرِمُونَۖ ٤٦",581,29],[47,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٧",581,29],[48,"وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ ٤٨",581,29],[49,"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ ٤٩",581,29],[50,"فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَۖ ٥٠",581,29]]}
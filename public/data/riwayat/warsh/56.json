{"s":56,"name":"الوَاقِعة","nameEn":"Al-Wāqi‘ah","ayahs":[[1,"إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ ١",534,27],[2,"لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ ٢",534,27],[3,"خَافِضَةٞ رَّافِعَةٌ ٣",534,27],[4,"اِذَا رُجَّتِ اِ۬لَارْضُ رَجّاٗ ٤",534,27],[5,"وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ ٥",534,27],[6,"فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ ٦",534,27],[7,"وَكُنتُمُۥٓ أَزْوَٰجاٗ ثَلَٰثَةٗۖ ٧",534,27],[8,"فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ ٨",534,27],[9,"مَآ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ ٩",534,27],[10,"وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ ١٠",534,27],[11,"مَآ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ ١١",534,27],[12,"وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ ١٢",534,27],[13,"أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ ١٣",534,27],[14,"فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ ١٤",534,27],[15,"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ ١٥",534,27],[16,"وَقَلِيلٞ مِّنَ اَ۬لَاخِرِينَ ١٦",534,27],[17,"عَلَىٰ سُرُرٖ مَّوْضُونَةٖ ١٧",534,27],[18,"مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ ١٨",534,27],[19,"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ ١٩",535,27],[20,"بِأَكْوَابٖ وَأَبَارِيقَ ٢٠",535,27],[21,"وَكَأْسٖ مِّن مَّعِينٖ ٢١",535,27],[22,"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ ٢٢",535,27],[23,"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٣",535,27],[24,"وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ ٢٤",535,27],[25,"وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ ٢٥",535,27],[26,"جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ ٢٦",535,27],[27,"لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَاثِيماًۖ ٢٧",535,27],[28,"اِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ ٢٨",535,27],[29,"وَأَصْحَٰبُ اُ۬لْيَمِينِ مَآ أَصْحَٰبُ اُ۬لْيَمِينِۖ ٢٩",535,27],[30,"فِے سِدْرٖ مَّخْضُودٖ ٣٠",535,27],[31,"وَطَلْحٖ مَّنضُودٖ ٣١",535,27],[32,"وَظِلّٖ مَّمْدُودٖ ٣٢",535,27],[33,"وَمَآءٖ مَّسْكُوبٖ ٣٣",535,27],[34,"وَفَٰكِهَةٖ كَثِيرَةٖ ٣٤",535,27],[35,"لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ ٣٥",535,27],[36,"وَفُرُشٖ مَّرْفُوعَةٍۖ ٣٦",535,27],[37,"اِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءٗ ٣٧",535,27],[38,"فَجَعَلْنَٰهُنَّ أَبْكَاراً ٣٨",535,27],[39,"عُرُباً اَتْرَاباٗ ٣٩",535,27],[40,"لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ ٤٠",535,27],[41,"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ ٤١",535,27],[42,"وَثُلَّةٞ مِّنَ اَ۬لَاخِرِينَۖ ٤٢",535,27],[43,"وَأَصْحَٰبُ اُ۬لشِّمَالِ ٤٣",535,27],[44,"مَآ أَصْحَٰبُ اُ۬لشِّمَالِۖ ٤٤",535,27],[45,"فِے سَمُومٖ وَحَمِيمٖ ٤٥",535,27],[46,"وَظِلّٖ مِّنْ يَّحْمُومٖ ٤٦",535,27],[47,"لَّا بَارِدٖ وَلَا كَرِيمٍۖ ٤٧",535,27],[48,"اِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ ٤٨",535,27],[49,"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ ٤٩",535,27],[50,"وَكَانُواْ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ ٥٠",535,27],[51,"أَوَءَابَآؤُنَا اَ۬لَاوَّلُونَۖ ٥١",535,27],[52,"۞ قُلِ اِنَّ اَ۬لَاوَّلِينَ وَالَاخِرِينَ لَمَجْمُوعُونَ ٥٢",535,27],[53,"إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ ٥٣",535,27],[54,"ثُمَّ إِنَّكُمُۥٓ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ ٥٤",536,27],[55,"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٥",536,27],[56,"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ ٥٦",536,27],[57,"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ ٥٧",536,27],[58,"فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ ٥٨",536,27],[59,"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ ٥٩",536,27],[60,"نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ ٦٠",536,27],[61,"أَفَرَٰٓيْتُم مَّا تُمْنُونَ ٦١",536,27],[62,"ءَآنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ ٦٢",536,27],[63,"نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ ٦٣",536,27],[64,"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ ٦٤",536,27],[65,"وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لُاول۪ىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ ٦٥",536,27],[66,"أَفَرَٰٓيْتُم مَّا تَحْرُثُونَ ٦٦",536,27],[67,"ءَآنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ ٦٧",536,27],[68,"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ ٦٨",536,27],[69,"إِنَّا لَمُغْرَمُونَ ٦٩",536,27],[70,"بَلْ نَحْنُ مَحْرُومُونَۖ ٧٠",536,27],[71,"أَفَرَٰٓيْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ ٧١",536,27],[72,"ءَآنتُمُۥٓ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ ٧٢",536,27],[73,"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗۖ فَلَوْلَا تَشْكُرُونَۖ ٧٣",536,27],[74,"أَفَرَٰٓيْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ ٧٤",536,27],[75,"ءَآنتُمُۥٓ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ اُ۬لْمُنشِـُٔونَۖ ٧٥",536,27],[76,"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةٗ وَمَتَٰعاٗ لِّلْمُقْوِينَۖ ٧٦",536,27],[77,"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ ٧٧",536,27],[78,"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ ٧٨",536,27],[79,"وَإِنَّهُۥ لَقَسَمٞ لَّوْ تَعْلَمُونَ عَظِيمٌ ٧٩",536,27],[80,"اِنَّهُۥ لَقُرْءَانٞ كَرِيمٞ ٨٠",537,27],[81,"فِے كِتَٰبٖ مَّكْنُونٖ ٨١",537,27],[82,"لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لْمُطَهَّرُونَۖ ٨٢",537,27],[83,"تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ ٨٣",537,27],[84,"أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ ٨٤",537,27],[85,"وَتَجْعَلُونَ رِزْقَكُمُۥٓ أَنَّكُمْ تُكَذِّبُونَۖ ٨٥",537,27],[86,"فَلَوْلَآ إِذَا بَلَغَتِ اِ۬لْحُلْقُومَ ٨٦",537,27],[87,"وَأَنتُمْ حِينَئِذٖ تَنظُرُونَ ٨٧",537,27],[88,"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ ٨٨",537,27],[89,"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ ٨٩",537,27],[90,"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَۖ ٩٠",537,27],[91,"فَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ ٩١",537,27],[92,"فَرَوْحٞ وَرَيْحَانٞ وَجَنَّتُ نَعِيمٖۖ ٩٢",537,27],[93,"وَأَمَّآ إِن كَانَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِ ٩٣",537,27],[94,"فَسَلَٰمٞ لَّكَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِۖ ٩٤",537,27],[95,"وَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُكَذِّبِينَ اَ۬لضَّآلِّينَ ٩٥",537,27],[96,"فَنُزُلٞ مِّنْ حَمِيمٖ ٩٦",537,27],[97,"وَتَصْلِيَةُ جَحِيمٍۖ ٩٧",537,27],[98,"اِنَّ هَٰذَا لَهُوَ حَقُّ اُ۬لْيَقِينِۖ ٩٨",537,27],[99,"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ ٩٩",537,27]]}
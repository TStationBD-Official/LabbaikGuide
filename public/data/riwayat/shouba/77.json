{"s":77,"name":"المُرسَلات","nameEn":"Al-Mursalāt","ayahs":[[1,"وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا ١",580,29],[2,"فَٱلۡعَٰصِفَٰتِ عَصۡفٗا ٢",580,29],[3,"وَٱلنَّٰشِرَٰتِ نَشۡرٗا ٣",580,29],[4,"فَٱلۡفَٰرِقَٰتِ فَرۡقٗا ٤",580,29],[5,"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا ٥",580,29],[6,"عُذۡرًا أَوۡ نُذُرًا ٦",580,29],[7,"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ ٧",580,29],[8,"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ ٨",580,29],[9,"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ ٩",580,29],[10,"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ ١٠",580,29],[11,"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ ١١",580,29],[12,"لِأَيِّ يَوۡمٍ أُجِّلَتۡ ١٢",580,29],[13,"لِيَوۡمِ ٱلۡفَصۡلِ ١٣",580,29],[14,"وَمَآ أَدۡرٜىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ ١٤",580,29],[15,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٥",580,29],[16,"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ ١٦",580,29],[17,"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ ١٧",580,29],[18,"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ١٨",580,29],[19,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٩",580,29],[20,"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ ٢٠",581,29],[21,"فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ ٢١",581,29],[22,"إِلَىٰ قَدَرٖ مَّعۡلُومٖ ٢٢",581,29],[23,"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ ٢٣",581,29],[24,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٢٤",581,29],[25,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا ٢٥",581,29],[26,"أَحۡيَآءٗ وَأَمۡوَٰتٗا ٢٦",581,29],[27,"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا ٢٧",581,29],[28,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٢٨",581,29],[29,"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ٢٩",581,29],[30,"ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ ٣٠",581,29],[31,"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ ٣١",581,29],[32,"إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ ٣٢",581,29],[33,"كَأَنَّهُۥ جِمَٰلَٰتٞ صُفۡرٞ ٣٣",581,29],[34,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٣٤",581,29],[35,"هَٰذَا يَوۡمُ لَا يَنطِقُونَ ٣٥",581,29],[36,"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ ٣٦",581,29],[37,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٣٧",581,29],[38,"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ ٣٨",581,29],[39,"فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ ٣٩",581,29],[40,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٠",581,29],[41,"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعِيُونٖ ٤١",581,29],[42,"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ٤٢",581,29],[43,"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ ٤٣",581,29],[44,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ٤٤",581,29],[45,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٥",581,29],[46,"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ ٤٦",581,29],[47,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٧",581,29],[48,"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ ٤٨",581,29],[49,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ٤٩",581,29],[50,"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ ٥٠",581,29]]}